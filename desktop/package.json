{
  "name": "nusa",
  "productName": "Nusa",
  "version": "1.0.2",
  "desktopName": "Nusa",
  "description": "Dynamic Island for Windows, macOS & Linux",
  "author": "Quraish Rahmatulloh",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "assets": "node scripts/assets.js",
    "start": "npm run assets && electron .",
    "test": "node test/run.js",
    "dist:win": "npm run assets && electron-builder --win nsis portable --x64",
    "dist:win:portable": "npm run assets && electron-builder --win portable --x64",
    "dist:linux": "npm run assets && electron-builder --linux AppImage deb --x64",
    "dist:mac": "npm run assets && electron-builder --mac dmg zip --x64 --arm64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "site.faquloh.nusa",
    "productName": "Nusa",
    "copyright": "\u00a9 2026 Quraish Rahmatulloh",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "media.js",
      "audio.js",
      "calendar.js",
      "location.js",
      "system.js",
      "privacy.js",
      "notifications.js",
      "phonedrop.js",
      "app/**/*",
      "build/tray.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Nusa-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "license": "build/license.txt",
      "shortcutName": "Nusa",
      "include": "build/installer.nsh",
      "artifactName": "Nusa-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Nusa-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "category": "Utility",
      "synopsis": "Dynamic Island for your desktop",
      "maintainer": "Hiroyki <340422942+Hiroyki@users.noreply.github.com>",
      "artifactName": "Nusa-${version}-${arch}.${ext}"
    },
    "deb": {
      "recommends": [
        "playerctl"
      ]
    }
  },
  "homepage": "https://github.com/Hiroyki/nusa"
}
